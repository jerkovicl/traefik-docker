# Copy this file to .env and fill in your values
# cp .env.example .env

# ── System ────────────────────────────────────────────────────────────────────
USERDIR=/home/username             # absolute path to your home dir, e.g. /home/john
PUID=1000                          # id -u
PGID=1000                          # id -g
TZ=Europe/Zagreb                   # TZ database name

# ── Networking ────────────────────────────────────────────────────────────────
DOMAINNAME=example.com             # REQUIRED — your root domain
DOCKER_SUBNET=172.20.0.0/16        # REQUIRED — Docker network subnet
LOCAL_SUBNET=192.168.1.0/24        # REQUIRED — your LAN subnet (used by VPN split-tunnel etc.)

# ── Cloudflare (Traefik ACME DNS challenge) ───────────────────────────────────
# Traefik v3 uses a scoped DNS API token via Docker secret (cf_dns_api_token),
# mounted as CF_DNS_API_TOKEN_FILE=/run/secrets/cf_dns_api_token in compose.
# Do NOT use legacy CLOUDFLARE_API_KEY here.
CLOUDFLARE_EMAIL=you@example.com      # ACME contact email only (mapped to CF_API_EMAIL)
# Create token secret file (outside .env):
#   mkdir -p ${USERDIR}/docker/secrets
#   echo "your_cloudflare_dns_api_token" > ${USERDIR}/docker/secrets/cf_dns_api_token
#   chmod 600 ${USERDIR}/docker/secrets/cf_dns_api_token

# ── Traefik ───────────────────────────────────────────────────────────────────
TRAEFIK_AUTH_BYPASS_KEY=change_me_long_random_string   # used in X-Header bypass for mobile apps
HTTP_USERNAME=admin
HTTP_PASSWORD=hashed_password                          # htpasswd -nb user password

# ── Authentik (SSO — REQUIRED) ────────────────────────────────────────────────
AUTHENTIK_VERSION=2024.4.2         # REQUIRED — pin to a specific release
AUTHENTIK_SECRET_KEY=              # REQUIRED — openssl rand -hex 32
AUTOBRR_SESSION_SECRET=            # REQUIRED — openssl rand -hex 32 (autobrr session signing)
AUTHENTIK_DB_PASSWORD=             # REQUIRED — strong random password

# ── MariaDB / MySQL ───────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@redis:6379

# ── SMTP (email alerts / Vaultwarden / Bitwarden) ────────────────────────────
SMTP_EMAIL=you@gmail.com
SMTP_PASSWORD=your_app_password    # Gmail App Password (not your account password)
LETSENCRYPT_EMAIL=you@example.com

# ── Vaultwarden / Bitwarden ───────────────────────────────────────────────────
ADMIN_TOKEN=                       # openssl rand -hex 32

# ── Plex ─────────────────────────────────────────────────────────────────────
PLEX_CLAIM=claim-xxxxxxxxxxxx      # https://www.plex.tv/claim (expires in 4 min)
LIBRARY_ID=

# ── Paperless-NGX ─────────────────────────────────────────────────────────────
PAPERLESS_PASSWORD=change_me

# ── Trakt (Radarr/Sonarr lists) ───────────────────────────────────────────────
TRAKT_ACCESS_TOKEN=
TRAKT_CLIENT_ID=

# ── IMDB lists ────────────────────────────────────────────────────────────────
IMDB_AT=
IMDB_LIST_ID=
IMDB_RATINGS_ID=
IMDB_UBID=

# ── Peekalink ────────────────────────────────────────────────────────────────
PEEKALINK_API_KEY=

# ── Pihole ────────────────────────────────────────────────────────────────────
PIHOLEIP=192.168.1.x

# ── OpenVPN ───────────────────────────────────────────────────────────────────
OPENVPN_PROVIDER=MULLVAD
OPENVPN_USERNAME=
OPENVPN_PASSWORD=
VIRTUAL_HOST_OPENVPN=vpn.example.com
VIRTUAL_PORT_OPENVPN=8080

# ── Tailscale ─────────────────────────────────────────────────────────────────
TAILSCALE_AUTH_KEY=                # REQUIRED — tskey-auth-... from Tailscale admin

# ── Headscale ─────────────────────────────────────────────────────────────────
HEADSCALE_API_KEY=
HEADSCALE_PRE_AUTH_KEY=
HEADPLANE_COOKIE_SECRET=           # openssl rand -hex 32

# ── Samba ─────────────────────────────────────────────────────────────────────
SAMBA_USER=username
SAMBA_PASSWORD=change_me

# ── VNC ───────────────────────────────────────────────────────────────────────
VNC_PASSWORD=change_me

# ── Slack notifications ───────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Keycloak (legacy — replaced by Authentik) ────────────────────────────────
KEYCLOAK_PASSWORD=change_me

# ── Generic DB vars (Headscale / Headplane) ───────────────────────────────────
DB_HOST=postgresql
DB_PORT=5432
DB_USERNAME=headscale
DB_PASSWORD=change_me
DB_DATABASE=headscale
DB_MIGRATIONS_PATH=/etc/headscale/migrations
DB_REPLICA_HOST=
DB_DEBUG_LEVEL=0

# ── App-level settings ────────────────────────────────────────────────────────
PORT=3000                          # REQUIRED — generic app port (used by some services)
LOG_LEVEL=info                     # REQUIRED
LOG_HTML=false                     # REQUIRED

# ── Auth (generic OAuth — traefik-forward-auth / other apps) ─────────────────
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_JWT_SECRET=
SESSION_SECRET=                    # openssl rand -hex 32

# ── Captcha ───────────────────────────────────────────────────────────────────
CAPTCHA_SOLVER=                    # REQUIRED — e.g. none, flaresolverr
